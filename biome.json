{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/.wrangler", "!**/worker-configuration.d.ts", "!prototype", "!docs/owner-confirmations.json", "!**/*.md", "!**/*.css"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 200 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "off" },
      "style": { "noNonNullAssertion": "error" },
      "correctness": { "useExhaustiveDependencies": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
