# Source documents and estate data stay out of the repository
*.docx
*.xlsx
~$*

# Local tools and OS files
.claude/
.DS_Store
pages/
proposal/

# Source PDFs from the owner and architecture (keep out of the repo like the .docx/.xlsx)
*.pdf

